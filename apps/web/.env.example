# URL dell'API (in produzione punta all'URL deployato, es. https://autoesperto-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL pubblico del sito (SEO: canonical, sitemap, robots, og:image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4052961089956241
NEXT_PUBLIC_ADSENSE_ENABLED=true
# Slot ID opzionali (creali in AdSense > Annunci > Per unità pubblicitaria > Display)
# NEXT_PUBLIC_ADSENSE_REPORT_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_HOME_SLOT=1234567890
ADSENSE_PUBLISHER_ID=pub-4052961089956241

# Google Ads — conversion tracking per Performance Max / Search
# Sostituisci con i tuoi ID reali da Google Ads > Strumenti > Misurazione conversioni
# Formato AW-XXXXXXXXX (Conversion ID) + etichetta evento purchase (Label)
NEXT_PUBLIC_GA_ADS_CONVERSION_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GA_ADS_PURCHASE_LABEL=xxxxxxxxx
