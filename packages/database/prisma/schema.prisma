generator client {
  provider = "prisma-client-js"
  output    = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String?        @unique
  phone           String?        @unique
  passwordHash    String?
  name            String?
  image           String?
  role            String         @default("USER")
  termsAcceptedAt DateTime?
  termsVersion    String?
  emailVerified   DateTime?
  emailVerifyToken String?      @unique
  signupIp        String?
  accounts        Account[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscription    Subscription?
  reports         Report[]
  savedVehicles   SavedVehicle[]
  dealerProfile   DealerProfile?
  purchases       Purchase[]
  analyses        Analysis[]
}

model Purchase {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String    @default("STRIPE")
  status                String    @default("PENDING")
  amountCents           Int
  currency              String    @default("eur")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, status])
}

model Analysis {
  id                         String    @id @default(cuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                      String
  vehicleJson                String
  photoAnalysisJson          String
  reportJson                 String
  sourceImageStored          Boolean   @default(false)
  immediateExecutionAccepted Boolean   @default(false)
  consentAt                  DateTime?
  termsVersion               String    @default("2026-08-02")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([userId])
}

model Account {
id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  provider     String // "google", "github", etc.
  providerId   String // ID from the provider
  email        String?
  name         String?
  image        String?
  accessToken  String?
  refreshToken String?
  expiresAt    Int?

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE")
  credits              Int       @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  renewsAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Vehicle {
  id            String         @id @default(cuid())
  plate         String?
  vin           String?
  make          String
  model         String
  version       String?
  year          Int?
  fuel          String?
  displacement  String?
  power         String?
  transmission  String?
  body          String?
  doors         Int?
  color         String?
  euroClass     String?
  imageUrl      String?
  reports       Report[]
  savedVehicles SavedVehicle[]
  createdAt     DateTime       @default(now())
}

model Report {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  reliabilityScore Float
  verdict          String
  marketValue      Float?
  marketMin        Float?
  marketMax        Float?
  summary          String
  fullAnalysis     String
  pdfUrl           String?
  createdAt        DateTime @default(now())
}

model SavedVehicle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}

model DealerProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id])
  companyName String
  vatNumber   String?
  phone       String?
  address     String?
  city        String?
  website     String?
  listings    DealerListing[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model DealerListing {
  id          String        @id @default(cuid())
  dealerId    String
  dealer      DealerProfile @relation(fields: [dealerId], references: [id])
  title       String
  price       Float
  km          Int
  year        Int
  fuel        String
  imageUrl    String?
  description String?
  source      String?
  sourceUrl   String?
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String?
  meta      String?
  visitorId String?
  userId    String?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId])
}
