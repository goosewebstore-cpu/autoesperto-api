{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autoesperto",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "autoesperto.it", "custom_domain": true },
    { "pattern": "www.autoesperto.it", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://autoesperto-api.onrender.com",
    "NEXT_PUBLIC_SITE_URL": "https://autoesperto.it",
    "ADSENSE_PUBLISHER_ID": "pub-4052961089956241"
  }
}
