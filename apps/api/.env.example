PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/autoesperto?sslmode=require
DATABASE_SCHEMA_SYNC=true
REGCHECK_USERNAME=demo

# Siti autorizzati (CORS), separati da virgola
WEB_URLS=http://localhost:3000
WEB_URL=http://localhost:3000

# Arricchimento valutazioni con IA (KB-first di default, AI solo se true)
AI_ENRICH=false

# AI Provider (compatibile OpenAI)
# Esempio con Groq (free tier): https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_your_groq_key
OPENAI_API_KEY=mock

# Account: segreto casuale di almeno 32 caratteri
JWT_SECRET=replace-with-a-long-random-secret

# Login Google (OAuth 2.0) - https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# URL di callback autorizzato in Google Cloud Console (OAuth 2.0 Client IDs > Web application > URI di reindirizzamento)
# In produzione: https://autoesperto-api.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Pagamento singolo Stripe: prezzo standard (3,99 €) — la promozione di lancio è terminata
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ANALYSIS_PRICE_CENTS=399
# La promozione di lancio è terminata il 13 agosto 2026 alle 23:59, ora italiana (CEST).
ANALYSIS_PROMO_PRICE_CENTS=199
ANALYSIS_PROMO_END_AT=2026-08-13T21:59:59.999Z
STRIPE_AUTOMATIC_TAX=false

# Brevo (invio email verifica)
# Ottieni la chiave su https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysb-xxxxxxxx
BREVO_SENDER=AutoEsperto <noreply@autoesperto.app>
# URL pubblico del sito (per link verifica email)
WEB_URLS=https://autoesperto.it,https://www.autoesperto.it,https://autoesperto.vercel.app
